# PucksData — Environment Variable Reference
# Copy to .env for local development (never commit .env).
# For Docker deployment, pass variables via: docker run -e DATABASE_URL="..." ...

# --- Database ---
# Direct (non-pooler) connection URL required for sqlx migrations.
# Neon: use the direct hostname (not -pooler) to support sqlx extended query protocol.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Daemon ---
# Sync interval in seconds (default: 21600 = 6 hours if unset).
# Override: docker run -e SYNC_INTERVAL_SECS=3600 ...
SYNC_INTERVAL_SECS=21600
