# Copy this file to .env and provide a PostgreSQL connection URL.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Database-backed tests require a database whose name contains "test".
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/pucksdata_test
# Optional safety override for another disposable database.
# PUCKSDATA_ALLOW_UNSAFE_TEST_DATABASE=1

# Daemon sync interval in seconds (defaults to 21600).
SYNC_INTERVAL_SECS=21600
